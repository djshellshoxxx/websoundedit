{
  "name": "@circuitdriftlabs/websoundedit",
  "version": "1.0.0-beta.2",
  "private": true,
  "type": "module",
  "description": "A local-first visual multitrack audio editor and scriptable audio engine by Circuit Drift Labs",
  "exports": {
    ".": "./src/engine.js",
    "./dsp": "./src/dsp.js",
    "./wav": "./src/wav.js",
    "./runtime": "./src/sdk-runtime.js",
    "./macro": "./src/macro.js"
  },
  "bin": {
    "websoundedit": "./scripts/cli.mjs"
  },
  "scripts": {
    "dev": "node scripts/prepare-stems.mjs && vite --host 127.0.0.1 --port 5182",
    "build": "node scripts/prepare-codecs.mjs && node scripts/prepare-stems.mjs && vite build && node scripts/verify-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4182",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:stem-model": "node scripts/verify-stem-model.mjs",
    "api": "node scripts/server.mjs",
    "edit": "node scripts/cli.mjs",
    "test:fuzz": "node scripts/verify-fuzz.mjs",
    "test:performance": "node scripts/benchmark-live-dsp.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@soundtouchjs/core": "2.1.1",
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.3",
    "libopus-wasm": "0.3.0",
    "onnxruntime-web": "1.31.1",
    "sql.js": "1.16.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
